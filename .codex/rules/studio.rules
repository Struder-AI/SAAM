# Shared SAAM Studio launcher permission. Load only in a trusted project.
# Run from the repository root; retain this literal script path.
# This trusts the script and its imports, not arbitrary Node commands.
prefix_rule(
    pattern = ["node", "studio/server.mjs"],
    decision = "allow",
    justification = "Run SAAM Studio's local preview server for this project's work.",
    match = [
        "node studio/server.mjs",
        "node studio/server.mjs Prints/my-part",
        'node studio/server.mjs "Prints/my part"',
    ],
    not_match = [
        "node studio/server.mjs.other",
        "node studio/other.mjs",
        "node --eval 1",
        "node --require other.mjs studio/server.mjs",
        "npm run studio",
        "taskkill /IM node.exe /F",
    ],
)

prefix_rule(
    pattern = ["sh", "saam.sh", "studio"],
    decision = "allow",
    justification = "Open SAAM Studio with the prepared private runtime.",
    match = ["sh saam.sh studio", 'sh saam.sh studio "Prints/my part"'],
    not_match = ["sh saam.sh setup", "sh saam.sh node --eval 1", "sh saam.sh npm install"],
)

prefix_rule(
    pattern = [".\\saam.ps1", "studio"],
    decision = "allow",
    justification = "Open SAAM Studio with the prepared private runtime.",
    match = ['".\\saam.ps1" studio Prints/my-part'],
    not_match = ['".\\saam.ps1" setup', '".\\saam.ps1" node --eval 1'],
)

prefix_rule(
    pattern = ["powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".\\saam.ps1", "studio"],
    decision = "allow",
    justification = "Run the trusted Studio launcher with a process-only script policy override.",
    match = ['powershell.exe -NoProfile -ExecutionPolicy Bypass -File ".\\saam.ps1" studio Prints/my-part'],
    not_match = ['powershell.exe -NoProfile -ExecutionPolicy Bypass -File ".\\saam.ps1" setup', 'powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Write-Output anything"'],
)
