      "extension": ".gcode",
      "flavor": "Griffin",
      "extrusionUnits": "mm-filament",
      "program": {
        "header": [
          ";START_OF_HEADER",
          ";HEADER_VERSION:0.1",
          ";FLAVOR:Griffin",
          ";GENERATOR.NAME:SAAM",
          ";GENERATOR.VERSION:4.4.0",
          ";SAAM.GENERATOR.VERSION:{generatorVersion}",
          ";GENERATOR.BUILD_DATE:{buildDate}",
          ";TARGET_MACHINE.NAME:Ultimaker S5",
          ";EXTRUDER_TRAIN.{tool}.INITIAL_TEMPERATURE:{nozzleC}",
          ";EXTRUDER_TRAIN.{tool}.MATERIAL.VOLUME_USED:{volume}",
          ";EXTRUDER_TRAIN.{tool}.MATERIAL.GUID:{materialGuid}",
          ";EXTRUDER_TRAIN.{tool}.NOZZLE.DIAMETER:{nozzleMm}",
          ";EXTRUDER_TRAIN.{tool}.NOZZLE.NAME:{core}",
          ";BUILD_PLATE.TYPE:glass",
          ";BUILD_PLATE.INITIAL_TEMPERATURE:{bedC}",
          ";BUILD_VOLUME.TEMPERATURE:{buildVolumeC}",
          ";PRINT.TIME:{seconds}",
          ";PRINT.GROUPS:1",
          ";PRINT.SIZE.MIN.X:{minX}",
          ";PRINT.SIZE.MIN.Y:{minY}",
          ";PRINT.SIZE.MIN.Z:{minZ}",
          ";PRINT.SIZE.MAX.X:{maxX}",
          ";PRINT.SIZE.MAX.Y:{maxY}",
          ";PRINT.SIZE.MAX.Z:{maxZ}",
          ";END_OF_HEADER"
        ],
        "start": [
          ";Clearance: operator responsibility for this demo",
          ";Firmware owns Griffin startup; this export does not request routine bed leveling.",
          "T{tool}",
          "G21",
          "G90",
          "M82",
          "M190 S{bedC}",
          "M109 T{tool} S{nozzleC}",
          "G0 Z{startupZ} F300",
          "G92 E0"
        ],
        "end": [
          "M400",
          "M104 T{tool} S0",
          "M140 S0",
          "M107",
          ";END_OF_SAAM"
        ]
      }
    }
  ],
  "exportGuidance": {
    "header": "Use a complete Griffin header, including GENERATOR.BUILD_DATE, the active tool's MATERIAL.GUID and BUILD_VOLUME.TEMPERATURE. The accepted PLA demo uses Generic PLA GUID 506c9f0d-e3aa-4bd4-b2d2-23e2425b1aa9 and build-volume temperature 28 C.",
    "troubleshooting": "A file rejected as missing necessary data may have incomplete metadata even when libCharon accepts it. Compare with a Cura S5 export; UFP contains /3D/model.gcode.",
    "acceptance": "User reports on 2026-09-08 that the final wedge change achieved the requested Ultimaker behavior: no bed leveling and no heating of the unused nozzle. Preserve this envelope, including Griffin compatibility 4.4.0, material identity and build-volume metadata. This observation does not establish complete print quality or physical clearance."
  },
  "clearance": {
