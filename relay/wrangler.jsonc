{
  // One Worker and one shared Durable Object relay chat MCP sessions to paired
  // local SAAM runtimes. See README.md and adapters/mcp/RELAY-PLAN.md.
  "name": "saam-relay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  // Needed for OAuth Client ID Metadata Document fetches (SSRF protection).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    // The public origin chat clients reach; the MCP resource is PUBLIC_URL/mcp.
    // Local development overrides it: wrangler dev --var PUBLIC_URL:http://localhost:8787
    "PUBLIC_URL": "https://saam-relay.remettub.workers.dev",
    // Computers that may pair at all: 2 while testing, 150 for alpha.
    "MAX_PAIRED_DEVICES": "2",
    // The release Studio offers as an update, as JSON:
    // {"version":"0.1.1","assets":{"win-x64":{"url":"https://…/SAAM-0.1.1-win-x64.zip","sha256":"…"}}}
    // Empty offers none. packaging/build.mjs prints each asset's entry.
    "LATEST_RELEASE": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayObject"] }],
  "kv_namespaces": [
    // Created with `wrangler kv namespace create OAUTH_KV`; another account creates its own.
    { "binding": "OAUTH_KV", "id": "324f3d91a05d4afa9ad4b39da4774920" }
  ]
}
