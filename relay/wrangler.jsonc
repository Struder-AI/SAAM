{
  // Optional alpha activation, release lookup and live diagnostics.
  "name": "saam-relay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  // Workers Logs: request outcomes, exceptions and service warnings,
  // viewable in the dashboard or live with `npx wrangler tail`.
  "observability": { "enabled": true },
  "vars": {
    // Maximum activated installations, a backstop behind invites.
    "MAX_PAIRED_DEVICES": "150",
    // The release Studio offers as an update, as JSON:
    // {"version":"0.1.1","assets":{"win-x64":{"url":"https://…/SAAM-0.1.1-win-x64.zip","sha256":"…"}}}
    // Empty offers none. packaging/build.mjs prints each asset's entry.
    "LATEST_RELEASE": "{\"version\":\"0.3.7\",\"assets\":{\"win-x64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.7/SAAM-0.3.7-win-x64.zip\",\"sha256\":\"f0420822364ee274bc3a9dc75fa98a44c558e72bab70fc4234382e8423e1282a\"},\"darwin-arm64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.7/SAAM-0.3.7-darwin-arm64.zip\",\"sha256\":\"f2d243d163d1ab9b8057da48d949cc9200b6ef226c80cb7b93fb4ad32b9f28eb\"},\"darwin-x64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.7/SAAM-0.3.7-darwin-x64.zip\",\"sha256\":\"5cf66f9e419cfbbd0b117d87896d860bd2864541c21a0b94bcf8ca4580da9cd1\"}}}",
    // Days received diagnostics are kept; "0" records nothing. Reading them,
    // and issuing invites, needs the OPERATOR_TOKEN secret (README.md#operating).
    "RECORD_DAYS": "30"
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayObject"] }]
}
