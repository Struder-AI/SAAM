{
  // Optional alpha activation, release lookup and live diagnostics.
  "name": "saam-relay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  // Workers Logs: request outcomes, exceptions and service warnings,
  // viewable in the dashboard or live with `npx wrangler tail`.
  "observability": { "enabled": true },
  "vars": {
    // Maximum activated installations, a backstop behind invites.
    "MAX_PAIRED_DEVICES": "150",
    // The release Studio offers as an update, as JSON:
    // {"version":"0.1.1","assets":{"win-x64":{"url":"https://…/SAAM-0.1.1-win-x64.zip","sha256":"…"}}}
    // Empty offers none. packaging/build.mjs prints each asset's entry.
    "LATEST_RELEASE": "{\"version\":\"0.3.6\",\"assets\":{\"win-x64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.6/SAAM-0.3.6-win-x64.zip\",\"sha256\":\"293b95dd0c7875677b340c68aa57157d90521bab366c5a279109ef7f81365c5f\"},\"darwin-arm64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.6/SAAM-0.3.6-darwin-arm64.zip\",\"sha256\":\"d800857b6baebabcd0aa408c2f884ff7d5d406645c4c5d8c8c77a592634bc0a8\"},\"darwin-x64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.6/SAAM-0.3.6-darwin-x64.zip\",\"sha256\":\"3b6cc5c7f475e080a0d22c3cde80e41f94501165033adb9fa812010d7f9d87d7\"}}}",
    // Days received diagnostics are kept; "0" records nothing. Reading them,
    // and issuing invites, needs the OPERATOR_TOKEN secret (README.md#operating).
    "RECORD_DAYS": "30"
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayObject"] }]
}
