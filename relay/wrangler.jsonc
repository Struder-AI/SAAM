{
  // Optional alpha activation, release lookup and live diagnostics.
  "name": "saam-relay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  // Workers Logs: request outcomes, exceptions and service warnings,
  // viewable in the dashboard or live with `npx wrangler tail`.
  "observability": { "enabled": true },
  "vars": {
    // Maximum activated installations, a backstop behind invites.
    "MAX_PAIRED_DEVICES": "150",
    // The release Studio offers as an update, as JSON:
    // {"version":"0.1.1","assets":{"win-x64":{"url":"https://…/SAAM-0.1.1-win-x64.zip","sha256":"…"}}}
    // Empty offers none. packaging/build.mjs prints each asset's entry.
    "LATEST_RELEASE": "{\"version\":\"0.3.4\",\"assets\":{\"win-x64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.4/SAAM-0.3.4-win-x64.zip\",\"sha256\":\"d3a0f015e2d084015183702820c6c3396aa1e448c160e1dbb3e3a58cf5c1a300\"},\"darwin-arm64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.4/SAAM-0.3.4-darwin-arm64.zip\",\"sha256\":\"9f652a8954a31c966151b3a2d908f9df56c9cdf73d66d854c0e8c71bb6d41aa9\"},\"darwin-x64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.4/SAAM-0.3.4-darwin-x64.zip\",\"sha256\":\"bb9f3ad28ee338c755cf7a64990ec29695cdf4a5c7ac0a8958ecc317c3aabff5\"}}}",
    // Days received diagnostics are kept; "0" records nothing. Reading them,
    // and issuing invites, needs the OPERATOR_TOKEN secret (README.md#operating).
    "RECORD_DAYS": "30"
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayObject"] }]
}
