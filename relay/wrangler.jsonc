{
  // Optional alpha activation, release lookup and live diagnostics.
  "name": "saam-relay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  // Workers Logs: request outcomes, exceptions and service warnings,
  // viewable in the dashboard or live with `npx wrangler tail`.
  "observability": { "enabled": true },
  "vars": {
    // Maximum activated installations, a backstop behind invites.
    "MAX_PAIRED_DEVICES": "150",
    // The release Studio offers as an update, as JSON:
    // {"version":"0.1.1","assets":{"win-x64":{"url":"https://…/SAAM-0.1.1-win-x64.zip","sha256":"…"}}}
    // Empty offers none. packaging/build.mjs prints each asset's entry.
    "LATEST_RELEASE": "{\"version\":\"0.3.6\",\"assets\":{\"win-x64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.6/SAAM-0.3.6-win-x64.zip\",\"sha256\":\"016d40b280cb169e34e0a52da6badcd2a64d6ec99abe02cd5f99d657a94f73a9\"},\"darwin-arm64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.6/SAAM-0.3.6-darwin-arm64.zip\",\"sha256\":\"fa6056173d5a47d2b0c4659697747e4f2fbbd7b53614f42f396a6e75937baf5c\"},\"darwin-x64\":{\"url\":\"https://github.com/Struder-AI/SAAM/releases/download/v0.3.6/SAAM-0.3.6-darwin-x64.zip\",\"sha256\":\"7e85af04ba3747901a974a24c1c8f7328adcce869b83ae879cd39156a824220f\"}}}",
    // Days received diagnostics are kept; "0" records nothing. Reading them,
    // and issuing invites, needs the OPERATOR_TOKEN secret (README.md#operating).
    "RECORD_DAYS": "30"
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayObject"] }]
}
