{
  "name": "saam",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SAAM development: composable toolpath skills with horizontal slices and draped-skin shell slicing across shared machine output.",
  "scripts": {
    "setup:check": "node scripts/setup-check.mjs",
    "test": "node --test core/tests/*.test.mjs skills/*/tests/*.test.mjs",
    "test:stress": "node --test --test-concurrency=1 core/tests/stress/*.test.mjs",
    "studio": "node packaging/launch.mjs",
    "agent": "node scripts/agent-toolkit.mjs",
    "saam": "node scripts/saam.mjs",
    "setup:mesh": "node scripts/build-mesh-repair.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "clipper2-wasm": "0.4.0",
    "fontkit": "2.0.4",
    "manifold-3d": "3.5.3",
    "rhino3dm": "8.32.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "fflate": "0.8.3"
  }
}
