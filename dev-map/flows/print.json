            "core/print/workflow.mjs::createBundleWorkflow::generateBundle",
            "core/print/workflow.mjs::createBundleWorkflow::currentGenerationCandidate",
            "core/print/workflow.mjs::createBundleWorkflow::promoteReviewedGeneration",
            "core/print/workflow.mjs::createBundleWorkflow::generationChecks",
            "core/print/workflow.mjs::createBundleWorkflow::persistGeneratedProgram"
          ]
        },
        {
          "id": "approval-delivery",
          "label": "approval and delivery",
          "members": [
            "core/print/workflow.mjs::createBundleWorkflow::approve",
            "core/print/workflow.mjs::createBundleWorkflow::deliver"
          ]
        }
