          "members": [
            "core/print/file-snapshot.mjs::createFileSnapshot",
            "core/print/generation-control.mjs::generationControl",
            "core/print/program-handoff.mjs::createCheckedProgramHandoff",
            "core/print/workflow.mjs::createBundleWorkflow"
          ],
          "groups": [
            {
              "id": "worker-identity",
              "label": "worker and file identity",
              "members": [
                "core/print/file-snapshot.mjs::createFileSnapshot",
                "core/print/generation-control.mjs::generationControl",
                "core/print/program-handoff.mjs::createCheckedProgramHandoff"
              ]
            }
          ]
        }
      ]
    },
    {
      "path": "core/print/workflow.mjs::createBundleWorkflow",
      "groups": [
        {
          "id": "setup",
          "label": "machine setup",
          "members": [
            "core/print/workflow.mjs::createBundleWorkflow::proposedPlan",
            "core/print/workflow.mjs::createBundleWorkflow::fitLineWidthToSetup",
            "core/print/workflow.mjs::createBundleWorkflow::rememberedSetup",
            "core/print/workflow.mjs::createBundleWorkflow::rememberSetup",
            "core/print/workflow.mjs::createBundleWorkflow::changeMachine"
          ]
        },
        {
          "id": "bundle-identity",
          "label": "bundle identity",
          "members": [
            "core/print/workflow.mjs::createBundleWorkflow::initBundle",
            "core/print/workflow.mjs::createBundleWorkflow::saveGeometry",
            "core/print/workflow.mjs::createBundleWorkflow::readBundleInput",
            "core/print/workflow.mjs::createBundleWorkflow::validateBundleInput",
            "core/print/workflow.mjs::createBundleWorkflow::describeBundle",
            "core/print/workflow.mjs::createBundleWorkflow::loadBundle",
            "core/print/workflow.mjs::createBundleWorkflow::bundleFingerprints",
            "core/print/workflow.mjs::createBundleWorkflow::bundleFingerprint"
          ]
        },
        {
          "id": "editing",
          "label": "plan edits",
          "members": [
            "core/print/workflow.mjs::createBundleWorkflow::adjustBundle",
