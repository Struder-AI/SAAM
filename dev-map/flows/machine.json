{
  "schema": 1,
  "flows": [
    {
      "path": "core/machine",
      "groups": [
        {
          "id": "setup",
          "label": "setup and limits",
          "members": [
            "core/machine/filaments.mjs::filamentSelection",
            "core/machine/profile.mjs::loadMachine",
            "core/machine/rules.mjs::centeredPlacement",
            "core/machine/rules.mjs::startupPosition",
            "core/machine/rules.mjs::startupRetracted",
            "core/machine/rules.mjs::sameNozzleMaterialChanges",
            "core/machine/rules.mjs::requireMachine",
            "core/machine/rules.mjs::checkMachinePath"
          ],
          "groups": [
            {
              "id": "tool-start",
              "label": "tool and start state",
              "members": [
                "core/machine/rules.mjs::centeredPlacement",
                "core/machine/rules.mjs::startupPosition",
                "core/machine/rules.mjs::startupRetracted"
              ]
            },
            {
              "id": "validation",
              "label": "setup and path checks",
              "members": [
                "core/machine/rules.mjs::requireMachine",
                "core/machine/rules.mjs::checkMachinePath"
              ]
            }
          ]
        }
      ]
    }
  ]
}
